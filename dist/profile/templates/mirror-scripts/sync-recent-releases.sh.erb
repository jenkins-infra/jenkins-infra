#!/usr/bin/env bash
set -o nounset
set -o errexit
set -o pipefail

BASE_DIR="<%= @release_root %>"
archives_jio_host="<%= @archives_jenkins_io_mirroring["username"] %>@<%= @archives_jenkins_io_mirroring["host"] %>"
archives_remote_dir="/srv/releases"

[[ $# -eq 1 ]] || { echo "Usage: $0 <recent-releases.json>" >&2 ; exit 1 ; }
[[ -f "$1" ]] || { echo "$1 is not a file" >&2 ; exit 2 ; }
RECENT_RELEASES_JSON="$1"

RECENT_RELEASES=$( jq --raw-output '.releases[] | .name + "/" + .version' "${RECENT_RELEASES_JSON}" )
if [[ -z "${RECENT_RELEASES}" ]] ; then
    echo "No recent releases"
    exit
fi

echo "${RECENT_RELEASES}"
echo

while IFS= read -r release; do
    # Ensure proper permissions are set (<%= @mirror_user %> is the owner and can write while www-data only need read access for webserver)
    find "${BASE_DIR}/plugins/${release}" -exec chown <%= @mirror_user %>:<%= @www_common_group %> {} \;
    find "${BASE_DIR}/plugins/${release}" -type f -exec chmod 644 {} \;
    find "${BASE_DIR}/plugins/${release}" -type d -exec chmod 755 {} \;

    echo "Uploading ${release} to archives.jenkins.io (fallback of get.jenkins.io)..."
    ssh -n "${archives_jio_host}" "mkdir -p jenkins/plugins/${release}"
    rsync --recursive \
        --links `# Copy symlinks as symlinks: destination is a Linux filesystem` \
        --perms `# Preserve permissions: destination is a Linux filesystem` \
        --times `# Preserve timestamps` \
        --devices --specials `# Preserve special files: destination is a Linux filesystem` \
        --compress `# CPU is cheap, bandwidth is not` \
        --verbose \
        "${BASE_DIR}/plugins/${release}/" `# Source` \
        "${archives_jio_host}:${archives_remote_dir}/plugins/${release}" `# Destination`

    # This marker file named 'TIME' must be created locally and then uploaded (to ensure mirrors reads its createtime and modtime)
    date +%s > "${BASE_DIR}/TIME"
    rsync --recursive \
        --links `# Copy symlinks as symlinks: destination is a Linux filesystem` \
        --perms `# Preserve permissions: destination is a Linux filesystem` \
        --times `# Preserve timestamps` \
        --devices --specials `# Preserve special files: destination is a Linux filesystem` \
        --compress `# CPU is cheap, bandwidth is not` \
        --verbose \
        "${BASE_DIR}/TIME" `# Source` \
        "${archives_jio_host}:${archives_remote_dir}/TIME" `# Destination`
    echo "Done uploading ${release} to archives.jenkins.io (fallback of get.jenkins.io)"
done <<< "${RECENT_RELEASES}"
