<%- if @jcasc['tools'] && @jcasc['tools']['disabled'].to_s != "true" -%>
unclassified:
  scmGit:
    globalConfigEmail: "jenkins-infra-team@<%= @ci_fqdn %>"
    globalConfigName: "jenkins-infra-team"
tool:
  <%- if @jcasc['tools']['generic'] -%>
  generic:
    installations:
    <%- @jcasc['tools']['generic'].each do |name, setup| -%>
    - name: "<%= name %>"
      properties:
      - installSource:
          installers:
          - zip:
              subdir: "<%= setup['subdir'] ? setup['subdir'] : name %>"
              url: "<%= setup['url'] %>"
              <%- if setup['label'] -%>
              label: "<%= setup['label'] %>"
          <%- end -%>
    <%- end -%>
  <%- end -%>
  git:
    installations:
    - home: "git"
      name: "git-native"
    - name: "jgit"
  <%- if @jcasc['tools']['groovy'] -%>
  groovy:
    installations:
    <%- @jcasc['tools']['groovy'].each do |name, setup| -%>
    - name: "<%= name %>"
      properties:
      - installSource:
          installers:
          - groovyInstaller:
              id: "<%= setup['version'] %>"
    <%- end -%>
  <%- end -%>
  <%- if @jcasc['tools']['jdk'] -%>
  jdk:
    installations:
    <%- @jcasc['tools']['jdk'].each do |name, setup| -%>
    - name: "<%= name %>"
      properties:
      - installSource:
          installers:
      <%- setup['installers'].each do |installer_name, installer_label| -%>
        <%- if installer_name =~ /windows/ -%>
          <%- $jdkHome = 'C:/Tools/jdk-' + setup['major_version'].to_s -%>
          <%- $installerType = 'batchFile' %>
        <%- else -%>
          <%- $jdkHome = '/opt/jdk-' + setup['major_version'].to_s -%>
          <%- $installerType = 'command' %>
        <%- end -%>
          - <%= $installerType %>:
              label: "<%= installer_label %>"
              toolHome: "<%= $jdkHome %>"
              command: "echo <%= $jdkHome %>"
      <%- end -%>
    <%- end -%>
  <%- end -%>
  <%- if @jcasc['tools']['maven'] -%>
  maven:
    installations:
    <%- @jcasc['tools']['maven'].each do |name, setup| -%>
      <%- unless setup['disabled'] -%>
    - name: "<%= name %>"
        <%- if setup['version'] -%>
      properties:
      - installSource:
          installers:
          - maven:
              id: "<%= setup['version'] %>"
        <%- elsif setup['home'] -%>
      home: "<%= setup['home'] %>"
        <%- end -%>
      <%- end -%>
    <%- end -%>
  mavenGlobalConfig:
    globalSettingsProvider: "standard"
    settingsProvider: "standard"
  <%- end -%>
<%- end -%>
