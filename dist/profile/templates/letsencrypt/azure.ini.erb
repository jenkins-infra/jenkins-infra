<%- if @plugin == "dns-azure" -%>
  <%- if @dns_azure['use_workload_identity'] -%>
dns_azure_use_workload_identity_credentials = true
  <%- else -%>
dns_azure_sp_client_id = "<%= @dns_azure['sp_client_id'] %>" # application_id
dns_azure_sp_client_secret = "<%= @dns_azure['sp_client_secret'] %>" # application_password.value
  <%- end -%>
dns_azure_environment = "AzurePublicCloud"
dns_azure_tenant_id = "<%= @dns_azure['tenant_id'] %>"
dns_azure_zone1 = "<%= @dns_azure['zone']['name'] %>:/subscriptions/<%= @dns_azure['zone']['subscription'] %>/resourceGroups/<%= @dns_azure['zone']['resource_group_name'] %>/providers/Microsoft.Network/dnsZones/<%= @dns_azure['zone']['name'] %>"
<%- elsif @plugin == "dns-multi" -%>
dns_multi_provider = azuredns
AZURE_TENANT_ID = "<%= @dns_azure['tenant_id'] %>"
AZURE_ENVIRONMENT = "public"
AZURE_ZONE_NAME = "<%= @dns_azure['zone']['name'] %>"
AZURE_RESOURCE_GROUP = "<%= @dns_azure['zone']['resource_group_name'] %>"
<%- end -%>
