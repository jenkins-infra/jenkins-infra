# Apache MIME Types Configuration
# Generated by Ansible - Do not edit manually

{% if apache_mime_types is defined and (apache_mime_types.handlers or apache_mime_types.types or apache_mime_types.output_filters) %}
# Custom Handlers
{% if apache_mime_types.handlers %}
{% for handler, value in apache_mime_types.handlers.items() %}
AddHandler {{ handler }} {{ value }}
{% endfor %}
{% endif %}

# Custom MIME Types
{% if apache_mime_types.types %}
{% for mime_type, extensions in apache_mime_types.types.items() %}
AddType {{ mime_type }} {{ extensions }}
{% endfor %}
{% endif %}

# Output Filters
{% if apache_mime_types.output_filters %}
{% for filter, extensions in apache_mime_types.output_filters.items() %}
AddOutputFilter {{ filter }} {{ extensions }}
{% endfor %}
{% endif %}
{% endif %}
